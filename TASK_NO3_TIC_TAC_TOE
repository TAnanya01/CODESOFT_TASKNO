
# Tic-Tac-Toe using Minimax Algorithm
# Human: X | Computer: O

import math

HUMAN = "X"
AI = "O"

board = [" "] * 9

WINNING_COMBINATIONS = [
    (0, 1, 2), (3, 4, 5), (6, 7, 8),
    (0, 3, 6), (1, 4, 7), (2, 5, 8),
    (0, 4, 8), (2, 4, 6)
]


def print_board():
    print()
    for row in range(3):
        values = []
        for col in range(3):
            index = row * 3 + col
            value = board[index] if board[index] != " " else str(index + 1)
            values.append(value)

        print(" " + " | ".join(values))
        if row < 2:
            print("---+---+---")
    print()


def check_winner(player):
    for a, b, c in WINNING_COMBINATIONS:
        if board[a] == board[b] == board[c] == player:
            return True
    return False


def is_draw():
    return " " not in board


def minimax(depth, is_maximizing):
    if check_winner(AI):
        return 10 - depth

    if check_winner(HUMAN):
        return depth - 10

    if is_draw():
        return 0

    if is_maximizing:
        best_score = -math.inf

        for i in range(9):
            if board[i] == " ":
                board[i] = AI
                score = minimax(depth + 1, False)
                board[i] = " "

                best_score = max(best_score, score)

        return best_score

    else:
        best_score = math.inf

        for i in range(9):
            if board[i] == " ":
                board[i] = HUMAN
                score = minimax(depth + 1, True)
                board[i] = " "

                best_score = min(best_score, score)

        return best_score


def find_best_move():
    best_score = -math.inf
    best_move = -1

    for i in range(9):
        if board[i] == " ":
            board[i] = AI
            score = minimax(0, False)
            board[i] = " "

            if score > best_score:
                best_score = score
                best_move = i

    return best_move


def main():
    print("=" * 35)
    print(" TIC-TAC-TOE USING MINIMAX ")
    print("=" * 35)
    print("You are X. Computer is O.")
    print("Choose a position from 1 to 9.")

    print_board()

    while True:
        try:
            move = int(input("Enter your move (1-9): ")) - 1
        except ValueError:
            print("Please enter a valid number.")
            continue

        if move < 0 or move > 8 or board[move] != " ":
            print("Invalid position! Choose an empty cell.")
            continue

        board[move] = HUMAN
        print_board()

        if check_winner(HUMAN):
            print("Congratulations! You win!")
            break

        if is_draw():
            print("It's a draw!")
            break

        print("Computer is thinking...")
        ai_move = find_best_move()
        board[ai_move] = AI

        print(f"Computer chooses position {ai_move + 1}.")
        print_board()

        if check_winner(AI):
            print("Computer wins! Better luck next time.")
            break

        if is_draw():
            print("It's a draw!")
            break


if __name__ == "__main__":
    main()
