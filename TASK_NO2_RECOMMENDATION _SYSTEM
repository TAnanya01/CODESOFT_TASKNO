
# Movie Recommendation System
# Created using Python

movies = [
    {"title": "Inception", "genre": ["Sci-Fi", "Thriller"], "rating": 8.8},
    {"title": "Interstellar", "genre": ["Sci-Fi", "Drama"], "rating": 8.7},
    {"title": "The Dark Knight", "genre": ["Action", "Crime"], "rating": 9.0},
    {"title": "Avengers: Endgame", "genre": ["Action", "Sci-Fi"], "rating": 8.4},
    {"title": "Iron Man", "genre": ["Action", "Sci-Fi"], "rating": 7.9},
    {"title": "Titanic", "genre": ["Romance", "Drama"], "rating": 7.9},
    {"title": "The Notebook", "genre": ["Romance", "Drama"], "rating": 7.8},
    {"title": "3 Idiots", "genre": ["Comedy", "Drama"], "rating": 8.4},
    {"title": "Dangal", "genre": ["Drama", "Sports"], "rating": 8.3},
    {"title": "Zindagi Na Milegi Dobara", "genre": ["Comedy", "Drama"], "rating": 8.2},
    {"title": "Joker", "genre": ["Crime", "Drama"], "rating": 8.3},
    {"title": "The Conjuring", "genre": ["Horror", "Thriller"], "rating": 7.5},
    {"title": "A Quiet Place", "genre": ["Horror", "Thriller"], "rating": 7.5},
    {"title": "Finding Nemo", "genre": ["Animation", "Adventure"], "rating": 8.2},
    {"title": "Toy Story", "genre": ["Animation", "Adventure"], "rating": 8.3}
]


def display_movies():
    print("\n--- Available Movies ---")
    for movie in movies:
        print(f"{movie['title']} | Rating: {movie['rating']}")


def recommend_movies(movie_name):
    selected_movie = None

    for movie in movies:
        if movie["title"].lower() == movie_name.lower():
            selected_movie = movie
            break

    if selected_movie is None:
        print("\nMovie not found in our database.")
        print("Please enter a movie name from the available list.")
        return

    recommendations = []

    for movie in movies:
        if movie["title"] == selected_movie["title"]:
            continue

        common_genres = set(movie["genre"]) & set(selected_movie["genre"])

        if common_genres:
            recommendations.append((movie, len(common_genres)))

    recommendations.sort(
        key=lambda item: (item[1], item[0]["rating"]),
        reverse=True
    )

    print(f"\nMovies similar to '{selected_movie['title']}':")

    if not recommendations:
        print("No similar movies found.")
        return

    for movie, score in recommendations[:5]:
        print(
            f"- {movie['title']} "
            f"| Genre: {', '.join(movie['genre'])} "
            f"| Rating: {movie['rating']}"
        )


def main():
    print("=" * 40)
    print("   MOVIE RECOMMENDATION SYSTEM")
    print("=" * 40)

    while True:
        print("\n1. View all movies")
        print("2. Get movie recommendations")
        print("3. Exit")

        choice = input("Enter your choice (1-3): ").strip()

        if choice == "1":
            display_movies()

        elif choice == "2":
            movie_name = input("Enter a movie name: ").strip()
            recommend_movies(movie_name)

        elif choice == "3":
            print("Thank you for using the system!")
            break

        else:
            print("Invalid choice. Please enter 1, 2, or 3.")


if __name__ == "__main__":
    main()
